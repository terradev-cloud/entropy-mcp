# Caddy terminates TLS (automatic Let's Encrypt) and proxies to the
# entropy-mcp container. Used by docker-compose.yml -- "entropy" is the
# compose service name, reachable on the internal network only.

entropy-mcp.terradev.cloud {
    @health path /health
    handle @health {
        respond "ok" 200
    }
    handle {
        reverse_proxy entropy:8001
    }
}
